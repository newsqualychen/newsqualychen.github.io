/themes/FixIt/.git/
/themes/**/public/
/themes/**/.hugo_build.lock

# Local backup files
.gitmodules.backup
posts-backup-*.tar.gz
posts-before-fixit-*.tar.gz

# Obsidian vault settings and workspace
/.obsidian/

