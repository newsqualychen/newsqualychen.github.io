# Hugo generated output
/public/
/resources/_gen/

# Hugo build lock
.hugo_build.lock

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor and temporary files
*.swp
*.swo
*~

# Local backups
config.backup-*/
*.backup
*.before-fixit

